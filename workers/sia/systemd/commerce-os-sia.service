[Unit]
Description=Commerce OS Supplier Intelligence & Acquisition Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/commerce-os/workers/sia
EnvironmentFile=/etc/commerce-os-research.env
ExecStart=/usr/bin/node /opt/commerce-os/workers/sia/service.mjs
Restart=always
RestartSec=30
User=root

[Install]
WantedBy=multi-user.target
